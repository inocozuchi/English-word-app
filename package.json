    "e2e": "node scripts/e2e.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@sveltejs/vite-plugin-svelte": "7.3.2",
    "@types/node": "22.20.5",
    "svelte": "5.59.1",
    "svelte-check": "4.7.8",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
