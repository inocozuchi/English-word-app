  "rules": {
    "timeBudget": "soft wall-clock budget; stop after current question, save and offer optional continuation; no mandatory completion of all core questions",
    "priority": "core first within budget; alternate skill types; no duplicate question in session except retry",
    "backlog": "if due review estimated time exceeds review budget, halve new item cap; carry overdue items without blocking day progression; no avalanche",
    "reviewDay": "sample due items and earlier days across skills; no new items required",
    "assessment": "Day0 and Day60 independent forms from assessment_reference; Day60 practice separate; pause/resume without answer leakage; 20 minute profile may split assessment",
    "audioUnavailable": "skip without penalty; record unavailable separately",
    "openAnswers": "self-grade after model answer; no AI or exact-match rejection of plausible alternatives",
    "resume": "persist day, queue IDs, cursor, answers, elapsed active time and selected profile after each response",
    "timing": "exclude pauses and audio loading; estimate from personal median after sufficient observations; default estimates are heuristic",
    "mastery": "recognition alone never implies retention; use delayed recall and production evidence",
    "survival": "optional short session, not a separate mandatory mode"
  },
