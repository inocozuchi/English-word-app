{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schemaVersion",
    "forms",
    "domainCounts",
    "scoring"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "forms": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": [
          "id",
          "day",
          "questions"
        ],
        "properties": {
          "id": {
            "enum": [
              "baseline",
              "final"
            ]
          },
          "day": {
            "enum": [
              0,
              60
            ]
          },
          "questions": {
            "type": "array",
            "minItems": 30,
            "items": {
              "type": "object",
              "required": [
                "id",
                "domain",
                "prompt",
                "scoring",
                "pairId",
                "explanation",
                "acceptedAnswers"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "domain": {
                  "type": "string"
                },
                "prompt": {
                  "type": "string"
                },
                "scoring": {
                  "type": "string"
                },
                "pairId": {
                  "type": "string"
                },
                "explanation": {
                  "type": "string"
                },
                "audioText": {
                  "type": "string"
                },
                "acceptedAnswers": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "domainCounts": {
      "type": "object"
    },
    "scoring": {
      "type": "object"
    }
  }
}